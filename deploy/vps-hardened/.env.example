# Copy to `.env` (same directory as docker-compose.yml) and fill in.
# `.env` is read by docker compose for ${VAR} substitution. Keep it 0600 and
# never commit it. This file holds NO provider API keys — those go into the
# container's own ~/.hermes/.env via `docker exec ... hermes login` (wiki/operations/vps-deployment.md
# step 5), which never lands them in `docker inspect`/`/proc/1/environ`.

# Runtime UID/GID inside the container. Match these to the owner you want on the
# hermes-data volume if you ever bind-mount it to a host path.
HERMES_UID=10000
HERMES_GID=10000

# Dashboard basic auth. Generate the hash offline — see wiki/operations/vps-deployment.md step 3.
# NEVER put a plaintext password in this file on a real deployment.
HERMES_DASHBOARD_USER=admin
HERMES_DASHBOARD_PW_HASH=scrypt$16384$8$1$REPLACE_ME

# Stable session-signing secret so logins survive a dashboard restart.
# Generate once with:  openssl rand -base64 32
HERMES_DASHBOARD_SECRET=REPLACE_WITH_32_RANDOM_BYTES
