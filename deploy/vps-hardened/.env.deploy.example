# Copy to `.env.deploy` at the REPO ROOT, fill in, then run:
#
#   scripts/setup-deploy-secrets.sh
#
# That script reads this file and writes the values straight into the GitHub
# `production` environment. The values go from your disk to GitHub and nowhere
# else — not into a commit, not into a chat transcript, not onto a command line
# where `ps` could read them.
#
# `.env.deploy` is gitignored. Keep it 0600 and delete it once the secrets are
# in GitHub: secrets there are write-only, so this file is a convenience for
# the initial setup, not a store you need to keep.
#
#   chmod 600 .env.deploy
#
# NOTE: this file holds only what the DEPLOY needs. It deliberately does not
# hold provider API keys (those go inside the container via `hermes login`,
# wiki/operations/vps-bootstrap.md step 5) nor HOSTINGER_API_TOKEN (account-wide credential, used
# only from your machine by hostinger-api.sh — never in CI).

# Hostname or IP of the VPS.
VPS_SSH_HOST=

# The deploy user created in wiki/operations/vps-bootstrap.md step 8. Not your personal login.
VPS_SSH_USER=hermes-deploy

# SSH port. Leave blank for 22.
VPS_SSH_PORT=

# Path to the PRIVATE key file — the path, not the key itself. The script reads
# the file and streams it to GitHub without ever printing it.
VPS_SSH_KEY_PATH=./hermes-deploy-key

# Path to a known_hosts file pinning the VPS host key. Generate with:
#   ssh-keyscan -H YOUR_HOST > ./hermes-known-hosts
# Verify the fingerprint out of band (hPanel console) before trusting it:
# ssh-keyscan is trust-on-first-use, so a compromised network at capture time
# would pin an attacker's key.
VPS_SSH_KNOWN_HOSTS_PATH=./hermes-known-hosts

# The domain in your Caddyfile, no scheme. Used by the public half of verify.sh.
HERMES_DOMAIN=
